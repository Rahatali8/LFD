# ── App ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEBUG=true

# ── Database ─────────────────────────────────────────
POSTGRES_USER=verifypk
POSTGRES_PASSWORD=verifypk123
POSTGRES_DB=verifypk
DATABASE_URL=postgresql+asyncpg://verifypk:verifypk123@db:5432/verifypk

# ── Redis ─────────────────────────────────────────────
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@redis:6379/0

# ── RabbitMQ ─────────────────────────────────────────
RABBITMQ_USER=verifypk
RABBITMQ_PASS=rabbit123
CELERY_BROKER_URL=amqp://verifypk:rabbit123@rabbitmq:5672/

# ── MinIO ─────────────────────────────────────────────
MINIO_USER=verifypk
MINIO_PASS=minio123456
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=verifypk-media

# ── AI Models ─────────────────────────────────────────
MODELS_PATH=/models
INSIGHTFACE_MODEL=buffalo_l
LIVENESS_THRESHOLD=0.6
FACE_MATCH_THRESHOLD=0.4
LIVENESS_SCORE_THRESHOLD=0.7

# ── API Keys ─────────────────────────────────────────
API_KEY_PREFIX_LIVE=live_pk_
API_KEY_PREFIX_TEST=test_pk_

# ── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8000
